generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Session model for persistence of sessions
model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@index([expiresAt])
}

// User model
model User {
  id           String   @id @default(cuid())
  username     String   @unique @db.VarChar(32)
  hash         String
  createdAt    DateTime @default(now())
  rootFolderId String?  @unique
  rootFolder   Folder?  @relation("RootFolder", fields: [rootFolderId], references: [id])

  folders Folder[] @relation("OwnedFolders")
  files   File[]
}

// Files belonging to users
model File {
  id           String   @id @default(cuid())
  originalname String
  mimetype     String
  filename     String
  size         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  folder       Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId     String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  shareId      String?
  share       Share?   @relation("SharedFiles", fields: [shareId], references: [id], onDelete: SetNull)
  rootShare Share?   @relation("ShareRootFile")

  @@index([userId])
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderHierarchy")
  files     File[]
  user      User     @relation("OwnedFolders", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  rootOwner User?    @relation("RootFolder")
  shareId   String?
  share    Share?   @relation("SharedFolders", fields: [shareId], references: [id], onDelete: SetNull)
  rootShare Share?   @relation("ShareRootFolder")

  @@unique([userId, parentId, name])
  @@index([userId])
}

model Share {
  id           String   @id @default(cuid())
  rootFolder   Folder?  @relation("ShareRootFolder", fields: [rootFolderId], references: [id], onDelete: Cascade)
  rootFolderId String?  @unique
  rootFile   File?  @relation("ShareRootFile", fields: [rootFileId], references: [id], onDelete: Cascade)
  rootFileId String?  @unique
  folders      Folder[] @relation("SharedFolders")
  files        File[]   @relation("SharedFiles")

  createdAt DateTime @default(now())
  expiresAt DateTime 
}
