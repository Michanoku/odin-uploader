generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// Session model for persistence of sessions
model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@index([expiresAt])
}

// User model
model User {
  id        String   @id @default(cuid())
  username  String   @unique @db.VarChar(32)
  hash      String
  createdAt DateTime @default(now())
  files     File[]
}

// Files belonging to users
model File {
  id           String @id @default(cuid())
  originalname String
  mimetype     String
  filename     String
  path         String
  size         Int
  owner        User   @relation(fields: [ownerId], references: [id])
  ownerId      String
}
