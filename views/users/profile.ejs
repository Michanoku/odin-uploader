<!DOCTYPE html>
<html lang="en" data-theme="<%= theme %>">
<%- include('../partials/head') %>
<%- include('../partials/icons') %>
  <body class="browser">
    <%- include('../partials/nav') %>
    <%- include('../partials/aside') %>
    <main class="flex">
        <div class="column">
    <div class="main-title">
      Profile
    </div>
    <hr>
    <%- include("../partials/errors.ejs") %>
    <form class="form-column" action="/profile" method="post">
        <label class="form-label" for="email">Email (current: <%= user.email %>)</label>
        <input id="email" type="text" name="email" minlength="2" maxlength="32" autocomplete="username">
        <label class="form-label" for="password">New Password</label>
        <input id="password" type="password" name="password" minlength="12" maxlength="72" autocomplete="new-password">
        <label class="form-label" for="confirmation">New Confirmation</label>
        <input id="confirmation" type="password" name="confirmation" minlength="12" maxlength="72" autocomplete="new-password">
        <label class="form-label" for="current-password">Current Password</label>
        <input id="current-password" type="password" name="current-password" minlength="12" maxlength="72" autocomplete="current-password">
        <button class="action-button" type="submit">Update</button>
    </form>
</div>
    </main>
    <%- include('../partials/footer') %>
  </body>

</html>