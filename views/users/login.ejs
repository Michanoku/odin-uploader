<!DOCTYPE html>
<html lang="en" data-theme="<%= theme %>">
<%- include('../partials/head') %>

  <body>
    <%- include('../partials/nav') %>
      <main class="flex">
        <div class="column">
          <div class="main-title">Login</div>
          <%- include("../partials/errors.ejs") %>
            <form class="form-column" action="/login" method="post">
              <label for="email" class="form-label">Email</label>
              <input id="email" type="email" name="email" maxlength="255" autocomplete="username">
              <label for="password" class="form-label">Password</label>
              <input id="password" type="password" name="password" minlength="12" maxlength="72"  autocomplete="current-password">
              <button class="action-button" type="submit">Login</button>
            </form>
            <span>Not a member? <a href="/register">Register</a>
        </div>
      </main>
      <%- include('../partials/footer') %>
  </body>

</html>