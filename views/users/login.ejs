<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

  <body>
    <%- include('../partials/nav') %>
      <main class="flex">
        <div class="column">
          <div class="main-title">Login</div>
          <%- include("../partials/errors.ejs") %>
            <form class="form-column" action="/login" method="post">
              <label for="username" class="form-label">Username</label>
              <input id="username" type="text" name="username" minlength="2" maxlength="32">
              <label for="password" class="form-label">Password</label>
              <input id="password" type="password" name="password" minlength="12" maxlength="72">
              <button class="action-button" type="submit">Login</button>
            </form>
            <span>Not a member? <a href="/register">Register</a>
        </div>
      </main>
      <%- include('../partials/footer') %>
  </body>

</html>