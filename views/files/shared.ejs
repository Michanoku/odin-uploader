<!DOCTYPE html>
<html lang="en" data-theme="<%= theme %>">
  <%- include('../partials/head') %>
  <%- include('../partials/icons') %>

  <body class="browser">
    <%- include('../partials/nav') %>
    <%- include('../partials/aside') %>
    <main>
      <div class="main-title">
        <% if (view === "folder") { %>
          <%= sharedFolder.name %>
        <% } else if (view === "file") { %>
          <%= file.originalname %>
        <% } else { %>
          Shared Content
        <% } %>
      </div>
      <% if (view === "folder" || view === "file") { %>
        <div class="breadcrumbs">
          <a class="breadcrumb" href="/shared/folder/<%= sharedRootId %>">Root</a>
          <% breadcrumbs.forEach((folder, index, breadcrumbs) => { if (folder.id !== sharedRootId) { %>
            >
            <a class="breadcrumb" href="/shared/folder/<%= folder.id %>">
              <%= folder.name %>
            </a>
          <% }}) %>
          <% if (typeof file !== "undefined" && file)  { %>
            > <%= file.originalname %>
          <% } %>
        </div>
      <% } %>
      <hr>
      <% if (view === "folder") { %>
        <%- include("./partials/sharedFolderContents") %>
      <% } else if (view === "file") { %>
        <%- include("./partials/sharedFileDetails") %>
      <% } else { %>
        <%- include("./partials/sharedAll") %>
      <% } %>
    </main>
    <%- include('../partials/footer') %>
  </body>

</html>