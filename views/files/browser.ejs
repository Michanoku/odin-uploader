<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

  <body class="browser">

  </div>
    <%- include('../partials/nav') %>
    <%- include('../partials/aside') %>
    <main>
    <div class="main-title">
    <% if (view === "folder") { %>
      <%= currentFolder.name %>
    <% } else { %>
      <%= file.originalname %>
    <% } %>
    </div>
    <div class="breadcrumbs">
    <a class="breadcrumb" href="/browser/folder/<%= user.rootFolderId %>">Root</a>
    <% breadcrumbs.forEach((folder, index, breadcrumbs) => { if (folder.id !== user.rootFolderId) { %>
      >
      <a class="breadcrumb" href="/browser/folder/<%= folder.id %>">
        <%= folder.name %>
      </a>
    <% }}) %>
    </div>
    <hr>
    <% if (view === "folder") { %>
      <%- include("./partials/folderContents") %>
    <% } else { %>
      <%- include("./partials/fileDetails") %>
    <% } %>
    </main>
    <%- include('../partials/footer') %>
  </body>

</html>