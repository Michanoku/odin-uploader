<aside>
  <div class="site-links">
    <% if (user) { %>
      <a class="site-link" href="/browser/folder/<%= user.rootFolderId %>">
        <svg class="folder-icon" width="24" height="24">
          <use href="#icon-folder"></use>
        </svg>
        <div class="folder-name">
          All Content
        </div>
      </a>
      <a class="site-link" href="/shared/all/">
        <svg class="folder-icon" width="24" height="24">
          <use href="#icon-share"></use>
        </svg>
        <div class="folder-name">
          Shared Content
        </div>
      </a>
    <% } %>
  </div>
  <div class="site-links">
    <% if (user) { %>
      <div class="info"><b>
          <%= user.email %>
        </b></div>
      <div class="info"><b>Storage used:</b>
        <%= storage %> of 500 KB.
      </div>
      <a class="site-link" href="/profile">
        <svg class="folder-icon" width="24" height="24">
          <use href="#icon-user"></use>
        </svg>
        <div class="folder-name">
          Profile
        </div>
      </a>
      <a class="site-link" href="/logout">
        <svg class="folder-icon" width="24" height="24">
          <use href="#icon-logout"></use>
        </svg>
        <div class="folder-name">
          Logout
        </div>
      </a>
    <% } else { %>
      <div class="info"><b>Anonymous User</b></div>
      <a class="site-link" href="/register">
        <svg class="folder-icon" width="24" height="24">
          <use href="#icon-register"></use>
        </svg>
        <div class="folder-name">
          Register
        </div>
      </a>
      <a class="site-link" href="/login">
        <svg class="folder-icon" width="24" height="24">
          <use href="#icon-login"></use>
        </svg>
        <div class="folder-name">
          Login
        </div>
      </a>
    <% } %>
  </div>
</aside>